{
  "name": "codex-usage-monitor",
  "version": "0.2.0",
  "description": "Adaptive desktop statistics strip for Codex conversations on Windows",
  "main": "desktop/main.js",
  "type": "commonjs",
  "scripts": {
    "test": "node --test test/*.test.js",
    "desktop": "electron desktop/main.js",
    "predesktop": "node desktop/build-native.js",
    "predesktop:package": "node desktop/build-native.js",
    "predesktop:dist": "node desktop/build-native.js",
    "desktop:package": "electron-builder --dir --config desktop/electron-builder.json",
    "desktop:dist": "electron-builder --config desktop/electron-builder.json --publish never"
  },
  "keywords": [
    "codex",
    "desktop",
    "windows",
    "usage",
    "tokens",
    "cache",
    "throughput"
  ],
  "author": "fazer-y",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fazer-y/codex-usage-monitor.git"
  },
  "bugs": {
    "url": "https://github.com/fazer-y/codex-usage-monitor/issues"
  },
  "homepage": "https://github.com/fazer-y/codex-usage-monitor#readme",
  "files": [
    "desktop/",
    "docs/",
    "lib/",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "smol-toml": "1.9.1"
  },
  "private": true,
  "contributors": [
    "harveyxiacn"
  ]
}
