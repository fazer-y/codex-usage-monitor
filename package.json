  },
  "bugs": {
    "url": "https://github.com/fazer-y/codex-usage-monitor/issues"
  },
  "homepage": "https://github.com/fazer-y/codex-usage-monitor#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
