{
  "appId": "dev.codex-usage-monitor.desktop",
  "productName": "Codex Usage Monitor",
  "directories": {
    "output": "dist/desktop"
  },
  "extraMetadata": {
    "main": "desktop/main.js"
  },
  "files": [
    "desktop/**/*",
    "lib/**/*",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "win": {
    "signAndEditExecutable": false,
    "target": ["nsis", "dir"]
  },
  "mac": {
    "target": ["dmg", "zip"]
  },
  "linux": {
    "target": ["AppImage", "deb"],
    "category": "Utility"
  }
}
