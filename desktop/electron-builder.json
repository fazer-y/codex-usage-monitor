{
  "appId": "dev.codex-usage-monitor.desktop",
  "productName": "Codex Usage Monitor",
  "directories": {
    "output": "dist/desktop"
  },
  "extraMetadata": {
    "main": "desktop/main.js"
  },
  "asarUnpack": ["desktop/native/bin/**/*"],
  "files": [
    "desktop/**/*",
    "!desktop/build-native.js",
    "!desktop/electron-builder.json",
    "!desktop/installer.nsh",
    "!desktop/native/WindowObserver.cs",
    "!desktop/assets/icon.ico",
    "lib/**/*",
    "package.json"
  ],
  "extraFiles": [
    { "from": "README.md", "to": "README.md" },
    { "from": "README.zh-CN.md", "to": "README.zh-CN.md" },
    { "from": "LICENSE", "to": "LICENSE.txt" },
    { "from": "plugin.json", "to": "plugin.json" },
    { "from": "mcp.json", "to": "mcp.json" },
    { "from": ".codex-plugin", "to": ".codex-plugin" }
  ],
  "win": {
    "icon": "desktop/assets/icon.ico",
    "signExecutable": false,
    "artifactName": "codex-usage-monitor-windows-${arch}.${ext}",
    "target": ["nsis"]
  },
  "nsis": {
    "include": "desktop/installer.nsh",
    "oneClick": true,
    "perMachine": false,
    "runAfterFinish": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "artifactName": "codex-usage-monitor-setup-windows-${arch}.${ext}"
  }
}
